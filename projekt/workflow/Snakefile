configfile: "config/config.yaml"
OUT = config["output_dir"]

rule all:
    input:
        f"{OUT}/04_vcf/final.vcf",
        "raport/statystyki.md",
        "raport/walidacja.md"

# --- Etap 1: ekstrakcja danych z pliku DArT ---
rule extract_probes:
    input:
        csv = config["dart_csv"]
    output:
        f"{OUT}/01_extract/probes.fa"
    params:
        first = config["dart_data_start_row"]
    shell:
        """
        awk -F',' 'NR>={params.first} && (NR-{params.first})%2==0 {{ print ">"$1; print $2 }}' {input.csv} > {output}
        """

rule extract_snp_info:
    input:
        csv = config["dart_csv"]
    output:
        f"{OUT}/01_extract/dart_info_oneline.tsv"
    params:
        first = config["dart_data_start_row"] + 1,
        col = config["dart_snp_col"]
    shell:
        """
        awk -F',' -v OFS='\\t' 'NR>={params.first} && (NR-{params.first})%2==0 {{ print $1, ${params.col} }}' {input.csv} > {output}
        """

# --- Etap 2: mapowanie BLAST ---
rule makeblastdb:
    input:
        fasta = config["genome_fasta"]
    output:
        f"{OUT}/02_blast/db/genome.nsq"
    params:
        prefix = f"{OUT}/02_blast/db/genome"
    conda:
        "envs/blast.yaml"
    log:
        "logs/makeblastdb.log"
    shell:
        "makeblastdb -in {input.fasta} -dbtype nucl -out {params.prefix} > {log} 2>&1"

rule blastn:
    input:
        query = f"{OUT}/01_extract/probes.fa",
        db = f"{OUT}/02_blast/db/genome.nsq"
    output:
        f"{OUT}/02_blast/blast_raw.tsv"
    params:
        prefix = f"{OUT}/02_blast/db/genome",
        evalue = config["blast_evalue"],
        mts = config["blast_max_target_seqs"],
        fields = "qseqid sseqid pident length mismatch gapopen qstart qend sstart send evalue bitscore"
    conda:
        "envs/blast.yaml"
    threads: 4
    log:
        "logs/blastn.log"
    shell:
        """
        blastn -task blastn \
            -db {params.prefix} \
            -query {input.query} \
            -out {output} \
            -evalue {params.evalue} \
            -max_target_seqs {params.mts} \
            -num_threads {threads} \
            -outfmt "6 {params.fields}" 2> {log}
        """
# ---- Etap 3: Filtrowanie wyników BLAST i ustalenie orientacji nici. #15
rule filtrowanie_blast:
    input:
        dane_wejsciowe = f"{OUT}/02_blast/blast_raw.tsv"
    output:
        wynik = f"{OUT}/03_blast_filter/dart_blast_filtered.tsv"
    params:
        identyczne = config["min_pident"],
        dlugosc = config["min_aln_len"]
    log:
        "logs/filtrowanie_wynikow_blast.log"
    shell:
        """
        awk -F'\\t' -v OFS='\\t' '$3 >= {params.identyczne} && $4 >= {params.dlugosc}' {input.dane_wejsciowe} > {OUT}/03_blast_filter/blast_96.tsv 2> {log}
        sort -k1,1 -k12,12gr {OUT}/03_blast_filter/blast_96.tsv | awk -F'\\t' '!widziane[$1]++' > {OUT}/03_blast_filter/blast_best.tsv 2>> {log}
        awk -F'\\t' -v OFS='\\t' '{{ print $0, ($9 < $10 ? "+" : "-") }}' {OUT}/03_blast_filter/blast_best.tsv > {output.wynik} 2>> {log}
        """

# ---- Etap 4:Obliczenie pozycji genomowej SNP. #16
rule pozycja_genomowa_snp:
    input:
        przefiltrowany_blast = f"{OUT}/03_blast_filter/dart_blast_filtered.tsv",
        informacje_snp = f"{OUT}/01_extract/dart_info_oneline.tsv"
    output:
        tabela_wariantow = f"{OUT}/04_vcf/step1_core.tsv"
    log:
        "logs/pozycja_genomowa_snp.log"
    shell:
        """
        awk -F'\\t' -v OFS='\\t' '{{ split($2, a, "[:>]"); print $1, a[1], a[2], a[3] }}' {input.informacje_snp} > {OUT}/04_vcf/dart_info_split.tsv 2> {log}
        awk -F'\\t' -v OFS='\\t' 'NR==FNR {{ info[$1] = $2 OFS $3 OFS $4; next }} {{ print $0, ($1 in info ? info[$1] : OFS OFS) }}' {OUT}/04_vcf/dart_info_split.tsv {input.przefiltrowany_blast} > {OUT}/04_vcf/dart_blast_with_snp.tsv 2>> {log}
        awk -F'\\t' -v OFS='\\t' '{{ sstart = $9; strand = $13; snp = $14; if (strand == "+") gpos = sstart + snp - 1; else if (strand == "-") gpos = sstart - snp + 1; else gpos = "NA"; print $0, gpos }}' {OUT}/04_vcf/dart_blast_with_snp.tsv > {OUT}/04_vcf/dart_blast_with_genomic_snp.tsv 2>> {log}
        awk -F'\\t' -v OFS='\\t' 'BEGIN {{ print "CHROM","POS","ID","REF","ALT","STRAND" }} {{ print $2, $NF, $1, $15, $16, $13 }}' {OUT}/04_vcf/dart_blast_with_genomic_snp.tsv > {output.tabela_wariantow} 2>> {log}
        """

# ---- korekta alleli dla nici minus (Issue #17)
rule korekta_alleli_minus:
    input:
        f"{OUT}/04_vcf/step1_core.tsv"
    output:
        f"{OUT}/04_vcf/step2_core_rc.tsv"
    log:
        "logs/bledy_korekta_alleli.log"
    shell:
        """
        awk -F'\\t' -v OFS='\\t' '
        function rc(b) {{
            if (b == "A") return "T"
            if (b == "T") return "A"
            if (b == "C") return "G"
            if (b == "G") return "C"
            return b
        }}
        NR == 1 {{ print; next }}
        {{
            if ($6 == "-") {{ $4 = rc($4); $5 = rc($5) }}
            print
        }}
        ' {input} > {output} 2> {log}
        """


# --- Etap 6: Konwersja macierzy DArT na genotypy ---
rule konwersja_genotypow:
    input:
        csv = config["dart_csv"]
    output:
        f"{OUT}/04_vcf/dart_genotypes.tsv"
    log:
        "logs/konwersja_genotypow.log"
    shell:
        "awk -f workflow/scripts/genotypy.awk {input.csv} > {output} 2> {log}"

# --- Etap 7: Dołączenie genotypów do wariantów ---
rule dolacz_genotypy:
    input:
        genotypes = f"{OUT}/04_vcf/dart_genotypes.tsv",
        core_rc = f"{OUT}/04_vcf/step2_core_rc.tsv"
    output:
        f"{OUT}/04_vcf/step3_with_genotypes.tsv"
    log:
        "logs/dolacz_genotypy.log"
    shell:
        """
        awk -F'\\t' -v OFS='\\t' '
        NR == FNR {{
            if (FNR == 1) {{ h = $0; next }}
            id = $1; $1 = ""; sub(/^\\t/, "", $0); g[id] = $0; next
        }}
        FNR == 1 {{
            tmp = h; sub(/^ID\\t?/, "", tmp)
            print $0, tmp; next
        }}
        {{ print $0, ($3 in g ? g[$3] : "") }}
        ' {input.genotypes} {input.core_rc} > {output} 2> {log}
        """

# --- Etap 7: Sortowanie i generowanie pliku VCF ---
rule generuj_vcf:
    input:
        f"{OUT}/04_vcf/step3_with_genotypes.tsv"
    output:
        vcf = f"{OUT}/04_vcf/final.vcf"
    log:
        "logs/generuj_vcf.log"
    shell:
        """
        awk -F'\\t' -v OFS='\\t' '
        NR == 1 {{
            print "##fileformat=VCFv4.2"
            print "##source=DArT-BLAST-pipeline"
            print "##INFO=<ID=STRAND,Number=1,Type=String,Description=\\"Orientacja dopasowania BLAST\\">"
            print "##FORMAT=<ID=GT,Number=1,Type=String,Description=\\"Genotype\\">"
            printf "#CHROM\\tPOS\\tID\\tREF\\tALT\\tQUAL\\tFILTER\\tINFO\\tFORMAT"
            for (i=7; i<=NF; i++) printf "\\t%s", $i
            printf "\\n"
            next
        }}
        {{
            printf "%s\\t%s\\t%s\\t%s\\t%s\\t.\\tPASS\\tSTRAND=%s\\tGT", $1, $2, $3, $4, $5, $6
            for (i=7; i<=NF; i++) printf "\\t%s", $i
            printf "\\n"
        }}' <(
            head -n 1 {input}
            tail -n +2 {input} | LC_ALL=C sort -t$'\\t' -k1,1 -k2,2n
        ) > {output.vcf} 2> {log}
        """

rule generuj_statystyki:
    input:
        probes = f"{OUT}/01_extract/probes.fa",
        blast_raw = f"{OUT}/02_blast/blast_raw.tsv",
        blast_filtered = f"{OUT}/03_blast_filter/dart_blast_filtered.tsv",
        blast_best = f"{OUT}/03_blast_filter/blast_best.tsv",
        vcf = f"{OUT}/04_vcf/final.vcf"
    output:
        "raport/statystyki.md"
    shell:
        """
        mkdir -p raport
        RAW=$(grep -c '>' {input.probes})
        HIT=$(cut -f1 {input.blast_raw} | sort -u | wc -l)
        FILT=$(wc -l < {input.blast_filtered})
        BEST=$(wc -l < {input.blast_best})
        PLUS=$(cut -f13 {input.blast_filtered} | grep -c '+')
        MINUS=$(cut -f13 {input.blast_filtered} | grep -c '-')
        VCF=$(grep -vc '^#' {input.vcf})

        echo "# Podsumowanie statystyczne potoku DArT -> VCF" > {output}
        echo "" >> {output}
        echo "| Etap potoku | Liczba |" >> {output}
        echo "|---|---|" >> {output}
        echo "| Sondy wejściowe | $RAW |" >> {output}
        echo "| Sondy z trafieniem BLAST | $HIT |" >> {output}
        echo "| Trafienia po filtrze | $FILT |" >> {output}
        echo "| Wybrane najlepsze dopasowania | $BEST |" >> {output}
        echo "| Orientacja nici (+ / -) | $PLUS / $MINUS |" >> {output}
        echo "| Ostateczne warianty w VCF | $VCF |" >> {output}
        """
rule generuj_walidacje:
    input:
        vcf = f"{OUT}/04_vcf/final.vcf",
        step2 = f"{OUT}/04_vcf/step2_core_rc.tsv",
        genome = config["genome_fasta"]
    output:
        "raport/walidacja.md"
    shell:
        """
        mkdir -p raport
        
        # 15.1 Kontrole podstawowe z Bloku 4
        HEADER_COUNT=$(grep -c '^##' {input.vcf} || true)
        VAR_COUNT=$(grep -vc '^#' {input.vcf} || true)
        COL_COUNT=$(awk -F'\\t' '!/^#/ {{ print NF }}' {input.vcf} | sort -u)
        DUP_COUNT=$(grep -v '^#' {input.vcf} | cut -f3 | sort | uniq -d | wc -l || true)

        # 15.2 Kontrola bcftools z Bloku 4
        BCF_STATUS="FAIL"
        if bcftools view {input.vcf} > /dev/null 2>&1; then
            BCF_STATUS="OK"
        fi
        BCF_STATS=$(bcftools stats {input.vcf} 2>&1 | head -n 30 || true)

        # 15.3 Kontrola spójności z genomem z Bloku 4
        samtools faidx {input.genome}
        awk -F'\\t' 'NR > 1 {{ print $1":"$2"-"$2 }}' {input.step2} > regiony.tmp
        samtools faidx -r regiony.tmp {input.genome} | grep -v '>' > zasady.tmp
        tail -n +2 {input.step2} | cut -f1-5 > rdzen.tmp

        ALIGN_STATS=$(paste rdzen.tmp zasady.tmp | awk -F'\\t' '
        {{
            g = toupper($6); r = toupper($4); a = toupper($5)
            if (g == r) eq_ref++
            else if (g == a) eq_alt++
            else poza++
        }}
        END {{
            n = eq_ref + eq_alt + poza
            print "genom = DArT REF:", eq_ref+0
            print "genom = DArT ALT:", eq_alt+0
            print "poza {{REF, ALT}}:", poza+0
            printf "spójnych (REF lub ALT): %.1f%%\\n", 100*(eq_ref+eq_alt)/n
        }}')

        rm -f regiony.tmp zasady.tmp rdzen.tmp

        # Zapis do raportu
        echo "# Wyniki walidacji pliku VCF" > {output}
        echo "" >> {output}
        echo "## 1. Kontrole podstawowe" >> {output}
        echo "- Wiersze nagłówkowe (##): $HEADER_COUNT" >> {output}
        echo "- Liczba wariantów: $VAR_COUNT" >> {output}
        echo "- Liczba kolumn danych: $COL_COUNT" >> {output}
        echo "- Zduplikowane ID markerów: $DUP_COUNT" >> {output}
        echo "- Formalna poprawność (bcftools view): $BCF_STATUS" >> {output}
        echo "" >> {output}
        echo "## 2. Statystyki bcftools stats" >> {output}
        echo '```' >> {output}
        echo "$BCF_STATS" >> {output}
        echo '```' >> {output}
        echo "" >> {output}
        echo "## 3. Spójność z genomem referencyjnym" >> {output}
        echo '```' >> {output}
        echo "$ALIGN_STATS" >> {output}
        echo '```' >> {output}
        """
