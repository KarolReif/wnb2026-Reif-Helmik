configfile: "config/config.yaml"
OUT = config["output_dir"]

rule all:
    input:
		f"{OUT}/04_vcf/step1_core.tsv"

# --- Etap 1: ekstrakcja danych z pliku DArT ---
rule extract_probes:
    input:
        csv = config["dart_csv"]
    output:
        f"{OUT}/01_extract/probes.fa"
    params:
        first = config["dart_data_start_row"]
    shell:
        """
        awk -F',' 'NR>={params.first} && (NR-{params.first})%2==0 {{ print ">"$1; print $2 }}' {input.csv} > {output}
        """

rule extract_snp_info:
    input:
        csv = config["dart_csv"]
    output:
        f"{OUT}/01_extract/dart_info_oneline.tsv"
    params:
        first = config["dart_data_start_row"] + 1,
        col = config["dart_snp_col"]
    shell:
        """
        awk -F',' -v OFS='\\t' 'NR>={params.first} && (NR-{params.first})%2==0 {{ print $1, ${params.col} }}' {input.csv} > {output}
        """

# --- Etap 2: mapowanie BLAST ---
rule makeblastdb:
    input:
        fasta = config["genome_fasta"]
    output:
        f"{OUT}/02_blast/db/genome.nsq"
    params:
        prefix = f"{OUT}/02_blast/db/genome"
    conda:
        "envs/blast.yaml"
    log:
        "logs/makeblastdb.log"
    shell:
        "makeblastdb -in {input.fasta} -dbtype nucl -out {params.prefix} > {log} 2>&1"

rule blastn:
    input:
        query = f"{OUT}/01_extract/probes.fa",
        db = f"{OUT}/02_blast/db/genome.nsq"
    output:
        f"{OUT}/02_blast/blast_raw.tsv"
    params:
        prefix = f"{OUT}/02_blast/db/genome",
        evalue = config["blast_evalue"],
        mts = config["blast_max_target_seqs"],
        fields = "qseqid sseqid pident length mismatch gapopen qstart qend sstart send evalue bitscore"
    conda:
        "envs/blast.yaml"
    threads: 4
    log:
        "logs/blastn.log"
    shell:
        """
        blastn -task blastn \
            -db {params.prefix} \
            -query {input.query} \
            -out {output} \
            -evalue {params.evalue} \
            -max_target_seqs {params.mts} \
            -num_threads {threads} \
            -outfmt "6 {params.fields}" 2> {log}
        """
# ---- Etap 3: Filtrowanie wyników BLAST i ustalenie orientacji nici. #15
rule filtrowanie_blast:
	input:
		dane_wejsciowe = f"{OUT}/02_blast/blast_raw.tsv"
	output:
		wynik = f"{OUT}/03_blast_filter/dart_blast_filtered.tsv"
	params:
		identyczne = config["min_pident"],
		dlugosc = config["min_aln_len"]
	log:
		"logs/filtrowanie_wynikow_blast.log"
	shell:
		"""
		awk -F'\\t' -v OFS='\\t' '$3 >= {params.identyczne} && $4 >= {params.dlugosc}' {input.dane_wejsciowe} > {OUT}/03_blast_filter/blast_96.tsv 2> {log}
		sort -k1,1 -k12,12gr {OUT}/03_blast_filter/blast_96.tsv | awk -F'\\t' '!widziane[$1]++' > {OUT}/03_blast_filter/blast_best.tsv 2>> {log}
		awk -F'\\t' -v OFS='\\t' '{{ print $0, ($9 < $10 ? "+" : "-") }}' {OUT}/03_blast_filter/blast_best.tsv > {output.wynik} 2>> {log}
		"""

# ---- Etap 4:Obliczenie pozycji genomowej SNP. #16
rule pozycja_genomowa_snp:
	input:
		przefiltrowany_blast = f"{OUT}/03_blast_filter/dart_blast_filtered.tsv",
		informacje_snp = f"{OUT}/01_extract/dart_info_oneline.tsv"
	output:
		tabela_wariantow = f"{OUT}/04_vcf/step1_core.tsv"
	log:
		"logs/pozycja_genomowa_snp.log"
	shell:
		"""
		awk -F'\\t' -v OFS='\\t' '{{ split($2, a, "[:>]"); print $1, a[1], a[2], a[3] }}' {input.informacje_snp} > {OUT}/04_vcf/dart_info_split.tsv 2> {log}
		awk -F'\\t' -v OFS='\\t' 'NR==FNR {{ info[$1] = $2 OFS $3 OFS $4; next }} {{ print $0, ($1 in info ? info[$1] : OFS OFS) }}' {OUT}/04_vcf/dart_info_split.tsv {input.przefiltrowany_blast} > {OUT}/04_vcf/dart_blast_with_snp.tsv 2>> {log}
		awk -F'\\t' -v OFS='\\t' '{{ sstart = $9; strand = $13; snp = $14; if (strand == "+") gpos = sstart + snp - 1; else if (strand == "-") gpos = sstart - snp + 1; else gpos = "NA"; print $0, gpos }}' {OUT}/04_vcf/dart_blast_with_snp.tsv > {OUT}/04_vcf/dart_blast_with_genomic_snp.tsv 2>> {log}
		awk -F'\\t' -v OFS='\\t' 'BEGIN {{ print "CHROM","POS","ID","REF","ALT","STRAND" }} {{ print $2, $NF, $1, $15, $16, $13 }}' {OUT}/04_vcf/dart_blast_with_genomic_snp.tsv > {output.tabela_wariantow} 2>> {log}
		"""
